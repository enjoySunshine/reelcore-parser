{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "es2022",
    "module": "es2022",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "#/*": ["./src/*"],
      "@types": ["./entries/types"],
      "entries/*": ["./entries/*"]
    }
  },
  "include": ["./bench/**/*"]
}
